# Fake database password (triggers generic-password-assignment rule)
DATABASE_PASSWORD="mysecret123"

# Fake API key (triggers generic-api-key-assignment rule)
API_KEY="FAKE_API_KEY_123456"

# Fake AWS secret (triggers aws-secret-key-assignment + built-in AWS rule)
AWS_SECRET_ACCESS_KEY="FAKE_TEST_SECRET_ONLY"

# Fake GitHub Personal Access Token (triggers built-in GitHub rule)
GITHUB_TOKEN="ghp_FAKETOKEN1234567890abcdefghijklmno"

# Fake generic token
ACCESS_TOKEN="superSecretToken_Demo_NotReal_9999"
